{
  "name": "tijdlijn-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tijdlijn-editor voor RTV Oost: dossiers als interactief verhaal",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:viewer && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:single": "npm run build:viewer && SINGLEFILE=1 vite build",
    "smoke": "node scripts/smoke.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
